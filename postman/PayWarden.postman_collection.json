          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// TOTP codes are single-use per operator. Wait for the next 30 s window so this",
                  "// operator gets a code it has not used yet in this run.",
                  "const ms = 30000 - (Date.now() % 30000) + 1500;",
                  "console.log(`waiting ${ms} ms for a fresh TOTP window`);",
                  "setTimeout(() => {}, ms);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
