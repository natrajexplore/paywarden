# ---- PayPal SANDBOX (developer.paypal.com -> Apps & Credentials -> Sandbox) ----
# Leave blank to run in MOCK mode (full flow, no real API calls).
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Only https://api-m.sandbox.paypal.com or https://api.sandbox.paypal.com are accepted.
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
# Webhook ID from the sandbox app's Webhooks section (needed to verify webhook signatures)
PAYPAL_WEBHOOK_ID=

# ---- AI engine: TypeSafe Jev (console.typesafe.ai) is used when its key is set; otherwise Claude;
#      with neither, the offline regex extractor (demo only). ----
TYPESAFE_API_KEY=
# Pin a version once thresholds are tuned, e.g. jev-1.14.0
TYPESAFE_MODEL=jev-latest

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# What is redacted before a document is sent to the model: off | standard | strict
# (off is refused when demo mode is false)
PAYWARDEN_REDACTION=standard

# ---- Demo mode ----
# true  = judge-friendly: demo tokens/TOTP seeds allowed, /api/demo/totp shows current codes, /docs on.
# false = production posture: the app REFUSES TO START unless every secret below is set to a
#         strong, non-demo value, both keys are set, and redaction is on.
PAYWARDEN_DEMO_MODE=true

# ---- Master keys: generate each with
#   python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
# Purpose keys (encryption, blind index, audit HMAC, approval binding) are derived via HKDF.
# Blank = ephemeral keys (demo mode only; data unreadable after restart).
PAYWARDEN_DATA_KEY=
PAYWARDEN_AUDIT_KEY=

# ---- Operators: one credential + one TOTP seed per person (segregation of duties) ----
# Tokens:  python -c "import secrets;print(secrets.token_urlsafe(32))"
# Seeds:   python -c "import pyotp;print(pyotp.random_base32(32))"
# Blank = public demo values (demo-maker-token / demo-checker-token, README seeds).
OPERATOR_MAKER_TOKEN=
OPERATOR_CHECKER_TOKEN=
OPERATOR_MAKER_TOTP=
OPERATOR_CHECKER_TOTP=
# External AI agents (MCP server): propose-only credential, distinct from operator tokens.
# Blank = public demo value demo-agent-token.
PAYWARDEN_AGENT_TOKEN=
# Lock an operator's approvals after N consecutive MFA failures, for this many seconds
MFA_MAX_FAILURES=5
MFA_LOCKOUT_SECONDS=900

ALLOWED_ORIGINS=http://localhost:8000
RATE_LIMIT_PER_MIN=120
MAX_BODY_BYTES=131072
# Behind N reverse proxies that each append to X-Forwarded-For, set N (0 = no proxy, use the peer IP)
TRUSTED_PROXY_HOPS=0
